package views

import (
	"fmt"
	"tpmod/internal/db"
)

templ EntityList(pizzas []db.Pizza) {
	<section id="pizzas-list">
		<h2>Menú de Pizzas</h2>
		if len(pizzas) == 0 {
			<p>No hay pizzas registradas todavía.</p>
		} else {
			<figure>
				<table>
					<thead>
						<tr>
							<th>ID</th>
							<th>Nombre</th>
							<th>Descripción</th>
							<th>Precio</th>
							<th>Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range pizzas {
							<tr>
								<td>{ fmt.Sprintf("%d", p.ID) }</td>
								<td><strong>{ p.Nombre }</strong></td>
								<td>{ p.Descripcion }</td>
								<td>${ p.Precio }</td>
								<td>
									<button 
										hx-delete={ fmt.Sprintf("/pizzas/%d", p.ID) }
										hx-target="closest tr"
										hx-swap="outerHTML"
										hx-confirm={ fmt.Sprintf("¿Estás seguro de que querés eliminar la pizza %s?", p.Nombre) }
										class="outline secondary" 
										style="padding: 0.25rem 0.5rem; font-size: 0.8rem;"
									>
										Eliminar
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</figure>
		}
	</section>
}